# Maintainer: Daniel Betz <dnlbtz@gmail.com>

pkgname=mbp143-audio
pkgver=1.0.1
pkgrel=1
pkgdesc='Audio DSP for the 15" MacBook Pro of 2017 (MacBookPro14,3): speaker and microphone graphs for PipeWire, with LV2 plugins'
arch=('x86_64')
url='https://github.com/dnlbtz/mbp143-audio'
license=('MIT')
# pipewire-audio carries the LV2 filter-graph plugin. The kernel driver is
# optional so that one installed without a package does not block this one.
depends=('glibc' 'libgcc' 'pipewire' 'pipewire-audio' 'wireplumber')
optdepends=('snd-hda-macbookpro-resume-dkms: the kernel driver for the sound card, with resume after hibernation and the headset mic')
makedepends=('cargo' 'git')
install=mbp143-audio.install
source=("git+$url.git")
sha256sums=('SKIP')

# v1.0.0 -> 1.0.0, three commits later 1.0.0.r3.g1234567
pkgver() {
  cd "$pkgname"
  git describe --long --tags --match 'v[0-9]*' --abbrev=7 2>/dev/null |
    sed -E 's/^v//; s/-0-g[0-9a-f]+$//; s/-([0-9]+)-g([0-9a-f]+)$/.r\1.g\2/' | grep . ||
    printf '0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

# makepkg's RUSTFLAGS (CachyOS: -C target-cpu=native) do not move the blocks'
# results: Rust fuses no a*b+c on its own.
build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  make CARGOFLAGS=--frozen
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  make check CARGOFLAGS=--frozen
}

package() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  make install PREFIX=/usr DESTDIR="$pkgdir" CARGOFLAGS=--frozen
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
