@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:mbp143-audio:mozart>
	a lv2:Plugin, lv2:CompressorPlugin ;
	doap:name "MacBook Pro 14,3 Mozart upward compressor" ;
	doap:license <https://spdx.org/licenses/MIT> ;
	lv2:project <urn:mbp143-audio> ;
	lv2:minorVersion 0 ;
	lv2:microVersion 0 ;
	rdfs:comment """Mozart from the MacBookPro14,3 speaker graph, at the head of the
common path. +9 dB input gain; a treble-weighted sidechain (150 Hz high-pass,
+4 dB shelf at 1680 Hz, -12 dB shelf at 8 kHz); the gain computed at sr/31 from
a 400 ms moving mean square through a log-domain gating follower, an activity
detector and a release and an attack transfer curve (1.8:1 from -18 dB, 1.6:1
expander below -60 dB floored at +6 dB), one attack/release state (100 ms /
1500 ms, the rise only while audio is active), an auto-threshold limiter, and a
134-tap interpolator back to sr; the audio delayed by 74 samples times that
gain.""" ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
	] , [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
	] , [
		a lv2:AudioPort, lv2:OutputPort ;
		lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
	] , [
		a lv2:AudioPort, lv2:OutputPort ;
		lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
	] , [
		a lv2:ControlPort, lv2:InputPort ;
		lv2:index 4 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
		lv2:portProperty lv2:toggled ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:ControlPort, lv2:OutputPort ;
		lv2:index 5 ; lv2:symbol "gain" ; lv2:name "Gain dB, after the input gain" ;
		lv2:default 0.0 ; lv2:minimum -40.0 ; lv2:maximum 30.0
	] , [
		a lv2:ControlPort, lv2:OutputPort ;
		lv2:index 6 ; lv2:symbol "latency" ; lv2:name "Latency" ;
		lv2:designation lv2:latency ;
		lv2:portProperty lv2:reportsLatency, lv2:integer ;
		lv2:default 74 ; lv2:minimum 0 ; lv2:maximum 256
	] .
