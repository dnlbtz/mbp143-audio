# SPDX-License-Identifier: MIT
#
# mbp143-audio: build and install the MacBookPro14,3 audio DSP.
#
#   make                  the LV2 bundle (cargo, lv2/)
#   make check            the tests (cargo test, dsp/tests)
#   make install          system-wide, under PREFIX (packages pass DESTDIR)
#   make uninstall
#
# What goes where:
#   $(LV2DIR)/mbp143-audio.lv2/                    the six plugins, one binary
#   $(DATADIR)/mbp143-audio/                        the graphs WirePlumber loads
#   $(DATADIR)/wireplumber/wireplumber.conf.d/     the rules: profile, 44100 Hz, the
#                                                   graph, the raw sink hidden
#   $(DATADIR)/wireplumber/scripts/device/         the profile after the jack, the raw
#                                                   sink's volume held at 0 dB, the
#                                                   headset mic's pre-amp
#   $(DATADIR)/pipewire/pipewire.conf.d/           a program's access decided by
#                                                   WirePlumber, so none reaches the
#                                                   raw sink before it is hidden
#
# graphs/speakers.json is generated by tools/layout_to_filter_chain.py from
# an AppleHDA layout and committed, so a build does not need the layout;
# graphs/mic.json is written by hand. A package build passes CARGOFLAGS=--frozen after a
# cargo fetch --locked.

PREFIX  ?= /usr/local
DATADIR ?= $(PREFIX)/share
LV2DIR  ?= $(PREFIX)/lib/lv2
DESTDIR ?=
CARGO   ?= cargo
CARGOFLAGS ?=

BUNDLE  = $(DESTDIR)$(LV2DIR)/mbp143-audio.lv2
PLUGINS = thermal controlfreak mozart dualband buzzkill loudness

all:
	$(CARGO) build --release $(CARGOFLAGS) -p mbp143-audio-lv2

check:
	$(CARGO) test --release $(CARGOFLAGS)

install: all
	install -Dm755 target/release/libmbp143audio.so $(BUNDLE)/mbp143-audio.so
	install -Dm644 lv2/manifest.ttl $(BUNDLE)/manifest.ttl
	for p in $(PLUGINS); do install -Dm644 lv2/$$p.ttl $(BUNDLE)/$$p.ttl; done
	install -Dm644 graphs/speakers.json \
	  $(DESTDIR)$(DATADIR)/mbp143-audio/speakers.json
	install -Dm644 graphs/mic.json \
	  $(DESTDIR)$(DATADIR)/mbp143-audio/mic.json
	install -d $(DESTDIR)$(DATADIR)/wireplumber/wireplumber.conf.d
	sed 's|@DATADIR@|$(DATADIR)|g' conf/wireplumber.conf.in \
	  > $(DESTDIR)$(DATADIR)/wireplumber/wireplumber.conf.d/90-mbp143-audio.conf
	chmod 644 $(DESTDIR)$(DATADIR)/wireplumber/wireplumber.conf.d/90-mbp143-audio.conf
	install -Dm644 conf/mbp143-audio-device.lua \
	  $(DESTDIR)$(DATADIR)/wireplumber/scripts/device/mbp143-audio-device.lua
	install -Dm644 conf/pipewire.conf \
	  $(DESTDIR)$(DATADIR)/pipewire/pipewire.conf.d/90-mbp143-audio.conf

uninstall:
	rm -rf $(BUNDLE)
	rm -rf $(DESTDIR)$(DATADIR)/mbp143-audio
	rm -f $(DESTDIR)$(DATADIR)/wireplumber/wireplumber.conf.d/90-mbp143-audio.conf
	rm -f $(DESTDIR)$(DATADIR)/wireplumber/scripts/device/mbp143-audio-device.lua
	rm -f $(DESTDIR)$(DATADIR)/pipewire/pipewire.conf.d/90-mbp143-audio.conf

clean:
	$(CARGO) clean

.PHONY: all check install uninstall clean
